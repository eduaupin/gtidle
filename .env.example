# Servidor
PORT=3001
NODE_ENV=development
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
CORS_ORIGIN=http://localhost:5173
DATA_FILE=./data/dev-db.json

# Produção (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:5432/grandtradeidle

# Mercado Pago — sem token, a loja roda em modo de teste (QR falso + botão de simular)
# Access Token de produção: mercadopago.com.br/developers > Suas integrações > sua aplicação > Credenciais de produção
MP_ACCESS_TOKEN=
# Chave secreta do webhook: Suas integrações > Webhooks > Configurar notificações
MP_WEBHOOK_SECRET=
# Minutos até o Pix expirar
PIX_EXPIRATION_MINUTES=30
# Stripe (cartão nacional e internacional, Apple Pay, Google Pay) — sem chave, roda em modo de teste
# Chave secreta: dashboard.stripe.com > Desenvolvedores > Chaves de API (começa com sk_live_ ou sk_test_)
STRIPE_SECRET_KEY=
# Segredo do webhook (começa com whsec_): Desenvolvedores > Webhooks > seu endpoint
STRIPE_WEBHOOK_SECRET=

# Endereço do jogo (para onde o Stripe devolve o jogador depois do pagamento)
PUBLIC_URL=http://localhost:5173
# Endereço público da API (https). Em localhost o webhook não chega, mas o jogo confirma consultando o status.
API_PUBLIC_URL=http://localhost:3001

# Notificações push (alerta "seu roubo está sendo monitorado").
# Sem estas chaves, o servidor gera um par em data/vapid.json na primeira vez (bom para testar).
# Em produção, gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Anúncio recompensado (Google H5 Games Ads). Sem o client, o jogo usa uma espera curta no lugar.
VITE_ADSENSE_CLIENT=
# Deixe "on" até o Google aprovar; troque para "off" para anúncios reais.
VITE_ADS_TEST=on
